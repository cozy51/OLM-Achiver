{
  "manifest_version": 3,
  "name": "Outlook Mail PDF Archiver",
  "version": "1.6.0",
  "description": "Outlook on the web で開いているメールを、元メールへのリンク付き PDF として保存します。",
  "permissions": [
    "clipboardRead",
    "debugger",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "このメールを PDF 保存",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
